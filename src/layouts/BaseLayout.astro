---
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '國立政治大學民族學系王雅萍副教授個人網站'
} = Astro.props;
---

<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={description}
    />

    <title>{title}</title>

    <script is:inline>
      try {
        const language =
          localStorage.getItem('site-language') || 'zh';

        document.documentElement.dataset.language = language;

        document.documentElement.lang =
          language === 'en' ? 'en' : 'zh-Hant';
      } catch (error) {
        document.documentElement.dataset.language = 'zh';
      }
    </script>
  </head>

  <body>
    <Navbar />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --background: #f4efe6;
    --text: #17251f;
    --text-secondary: #65706b;
    --green: #2f6652;
    --brown: #a85d38;
    --border: #d8d1c5;
  }

  * {
    box-sizing: border-box;
  }

  html {
    margin: 0;
    padding: 0;
    background: var(--background);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    margin: 0;
    padding: 0;

    background: var(--background);
    color: var(--text);

    font-family:
      Arial,
      "Noto Sans TC",
      "PingFang TC",
      "Microsoft JhengHei",
      sans-serif;
  }

  a {
    color: inherit;
  }

  [data-lang="en"] {
    display: none;
  }

  html[data-language="en"] [data-lang="zh"] {
    display: none !important;
  }

  html[data-language="en"] [data-lang="en"] {
    display: revert;
  }
</style>