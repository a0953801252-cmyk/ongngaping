---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="計畫參與｜王雅萍 Ong Nga Ping"
  description="國立政治大學王雅萍副教授研究計畫、教育計畫與社會實踐計畫"
>
  <main class="page">

    <header class="page-header">
      <p class="eyebrow">PROJECTS</p>

      <h1>
        <span data-lang="zh">
          計畫參與
        </span>

        <span data-lang="en">
          Projects
        </span>
      </h1>

      <p class="intro">
        <span data-lang="zh">
          本頁整理王雅萍副教授歷年參與之研究、
          教育、原住民族、地方創生及大學社會責任相關計畫。
        </span>

        <span data-lang="en">
          This page presents research, educational,
          Indigenous, placemaking, and university social responsibility
          projects involving Ong Nga Ping.
        </span>
      </p>
    </header>


    <!-- 研究計畫 -->

    <section>
      <p class="section-label">
        RESEARCH PROJECTS
      </p>

      <h2>
        <span data-lang="zh">
          研究計畫
        </span>

        <span data-lang="en">
          Research Projects
        </span>
      </h2>

      <div class="project-list">

        <article class="project-item">
          <div class="project-number">
            01
          </div>

          <div>
            <h3>
              <span data-lang="zh">
                民族與原住民族研究
              </span>

              <span data-lang="en">
                Ethnic & Indigenous Research
              </span>
            </h3>

            <p>
              <span data-lang="zh">
                整理民族教育、原住民族文化、
                語言及地方社會相關研究計畫。
              </span>

              <span data-lang="en">
                Research projects related to ethnic education,
                Indigenous cultures, languages, and local communities.
              </span>
            </p>
          </div>
        </article>

      </div>
    </section>


    <!-- 教育 -->

    <section>
      <p class="section-label">
        EDUCATION PROJECTS
      </p>

      <h2>
        <span data-lang="zh">
          教育與人才培育計畫
        </span>

        <span data-lang="en">
          Education & Training Projects
        </span>
      </h2>

      <div class="project-list">

        <article class="project-item">
          <div class="project-number">
            02
          </div>

          <div>
            <h3>
              <span data-lang="zh">
                原住民族教育與族語人才培育
              </span>

              <span data-lang="en">
                Indigenous Education & Language Training
              </span>
            </h3>

            <p>
              <span data-lang="zh">
                整理原住民族教育、族語師資、
                課程推廣及相關人才培育計畫。
              </span>

              <span data-lang="en">
                Projects involving Indigenous education,
                language teacher training, curriculum development,
                and professional training.
              </span>
            </p>
          </div>
        </article>

      </div>
    </section>


    <!-- USR -->

    <section>
      <p class="section-label">
        SOCIAL PRACTICE
      </p>

      <h2>
        <span data-lang="zh">
          大學社會責任與地方實踐
        </span>

        <span data-lang="en">
          University Social Responsibility
        </span>
      </h2>

      <div class="project-list">

        <article class="project-item">
          <div class="project-number">
            03
          </div>

          <div>
            <h3>
              <span data-lang="zh">
                社區、地方創生與社會實踐
              </span>

              <span data-lang="en">
                Community, Placemaking & Social Practice
              </span>
            </h3>

            <p>
              <span data-lang="zh">
                整理與地方社區、原住民族部落、
                地方創生、大學社會責任及行動學習相關之計畫。
              </span>

              <span data-lang="en">
                Community-based projects involving Indigenous communities,
                placemaking, university social responsibility,
                and action-based learning.
              </span>
            </p>
          </div>
        </article>

      </div>
    </section>


    <!-- 國際 -->

    <section>
      <p class="section-label">
        INTERNATIONAL COLLABORATION
      </p>

      <h2>
        <span data-lang="zh">
          國際與跨國合作
        </span>

        <span data-lang="en">
          International Collaboration
        </span>
      </h2>

      <div class="project-list">

        <article class="project-item">
          <div class="project-number">
            04
          </div>

          <div>
            <h3>
              <span data-lang="zh">
                臺灣與東南亞交流
              </span>

              <span data-lang="en">
                Taiwan–Southeast Asia Collaboration
              </span>
            </h3>

            <p>
              <span data-lang="zh">
                整理與泰國及其他東南亞地區之
                社區發展、文化資源與跨國交流計畫。
              </span>

              <span data-lang="en">
                Projects connecting Taiwan with Thailand
                and other Southeast Asian regions through
                community development, cultural resources,
                and transnational exchange.
              </span>
            </p>
          </div>
        </article>

      </div>
    </section>


    <section>
      <p class="section-label">
        PROJECT RECORD
      </p>

      <h2>
        <span data-lang="zh">
          歷年計畫紀錄
        </span>

        <span data-lang="en">
          Project Record
        </span>
      </h2>

      <p class="note">
        <span data-lang="zh">
          詳細計畫名稱、執行期間、擔任角色及補助單位，
          將依官方學術履歷與各計畫公開資料整理更新。
        </span>

        <span data-lang="en">
          Project titles, periods, roles, and funding organizations
          will be updated according to official academic and project records.
        </span>
      </p>
    </section>

  </main>
</BaseLayout>


<style>
  .page {
    width: min(1080px, calc(100% - 48px));
    margin: 0 auto;
    padding: 100px 0 130px;
  }

  .page-header {
    max-width: 850px;
    padding-bottom: 90px;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 14px;

    color: var(--brown);

    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 0;

    color: var(--text);

    font-size: clamp(52px, 8vw, 88px);
    line-height: 1.05;
  }

  .intro {
    max-width: 800px;

    margin: 36px 0 0;

    color: var(--text-secondary);

    font-size: 19px;
    line-height: 1.9;
  }

  section {
    padding: 64px 0;

    border-top: 1px solid var(--border);
  }

  h2 {
    margin: 8px 0 42px;

    color: var(--text);

    font-size: clamp(30px, 4vw, 40px);
  }

  .project-list {
    border-top: 1px solid var(--border);
  }

  .project-item {
    display: grid;
    grid-template-columns: 70px 1fr;

    gap: 28px;

    padding: 32px 0;

    border-bottom: 1px solid var(--border);
  }

  .project-number {
    color: var(--brown);

    font-size: 14px;
    font-weight: 700;
  }

  .project-item h3 {
    margin: 0;

    color: var(--text);

    font-size: 21px;
    line-height: 1.5;
  }

  .project-item p,
  .note {
    max-width: 760px;

    margin: 13px 0 0;

    color: var(--text-secondary);

    font-size: 16px;
    line-height: 1.85;
  }

  @media (max-width: 700px) {
    .page {
      width: calc(100% - 40px);

      padding: 60px 0 80px;
    }

    .page-header {
      padding-bottom: 60px;
    }

    .intro {
      font-size: 16px;
    }

    section {
      padding: 45px 0;
    }

    .project-item {
      grid-template-columns: 40px 1fr;

      gap: 12px;
    }
  }
</style>