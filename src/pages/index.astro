---
import BaseLayout from '../layouts/BaseLayout.astro';

const base =
  import.meta.env.BASE_URL.replace(/\/$/, '');

const profileImages = [
  `${base}/professor.jpg`,
  `${base}/professor2.jpg`,
  `${base}/professor3.jpg`,
];
---

<BaseLayout
  title="王雅萍 Ong Nga Ping｜國立政治大學民族學系"
  description="國立政治大學民族學系王雅萍副教授個人網站"
>
  <main class="home">

    <section class="hero">
      <div class="hero-content">

        <p class="eyebrow">
          <span data-lang="zh">
            國立政治大學 · 民族學系
          </span>

          <span data-lang="en">
            Department of Ethnology · National Chengchi University
          </span>
        </p>

        <h1>王雅萍</h1>

        <p class="english-name">
          Ong Nga Ping
        </p>

        <p class="position">
          <span data-lang="zh">
            副教授｜社會科學學院民族學系
          </span>

          <span data-lang="en">
            Associate Professor · Department of Ethnology
          </span>
        </p>

        <p class="description">
          <span data-lang="zh">
            研究與教學聚焦民族教育、臺灣民族史、
            東南亞民族與現況、社區營造與民族學研究方法。
          </span>

          <span data-lang="en">
            Research and teaching interests include ethnic and
            Indigenous education, ethnic history of Taiwan,
            contemporary Southeast Asia, community engagement,
            and research methods in ethnology.
          </span>
        </p>

        <div class="actions">
          <a
            class="primary-button"
            href={`${base}/research/`}
          >
            <span data-lang="zh">查看研究</span>
            <span data-lang="en">Research</span>
          </a>

          <a
            class="secondary-button"
            href={`${base}/contact/`}
          >
            <span data-lang="zh">聯絡王老師</span>
            <span data-lang="en">Contact</span>
          </a>
        </div>

      </div>

      <div
  class="portrait-slider"
  id="professor-slider"
  aria-label="王雅萍副教授照片"
>
  <div class="slides">

    {
      profileImages.map((image, index) => (
        <img
          src={image}
          alt={`王雅萍副教授照片 ${index + 1}`}
          class:list={[
            'slide',
            { active: index === 0 }
          ]}
          data-slide={index}
        />
      ))
    }

  </div>

  <!-- 左右切換 -->
  <button
    class="slider-button previous"
    type="button"
    aria-label="上一張照片"
  >
    ‹
  </button>

  <button
    class="slider-button next"
    type="button"
    aria-label="下一張照片"
  >
    ›
  </button>

  <!-- 下方圓點 -->
  <div class="slider-dots">
    {
      profileImages.map((_, index) => (
        <button
          type="button"
          class:list={[
            'slider-dot',
            { active: index === 0 }
          ]}
          data-dot={index}
          aria-label={`顯示第 ${index + 1} 張照片`}
        />
      ))
    }
  </div>
</div>
    </section>

  </main>
</BaseLayout>

<style>
  .home {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .hero {
    min-height: calc(100vh - 103px);

    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    align-items: center;

    gap: 90px;

    padding: 90px 0 110px;
  }

  .hero-content {
    max-width: 760px;
  }

  .eyebrow {
    margin: 0 0 30px;

    color: var(--brown);

    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;

    font-family: Georgia, "Noto Serif TC", serif;

    color: var(--text);

    font-size: clamp(72px, 10vw, 132px);
    font-weight: 500;
    line-height: 0.95;
  }

  .english-name {
    margin: 26px 0 0;

    color: var(--green);

    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;

    letter-spacing: 0.04em;
  }

  .position {
    margin: 52px 0 0;

    color: var(--text-secondary);

    font-size: 23px;
    line-height: 1.6;
  }

  .description {
    max-width: 750px;

    margin: 42px 0 0;

    color: var(--text-secondary);

    font-size: 19px;
    line-height: 1.9;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;

    gap: 14px;

    margin-top: 40px;
  }

  .actions a {
    padding: 14px 24px;

    border-radius: 999px;

    text-decoration: none;
    font-weight: 700;
  }

  .primary-button {
    background: var(--green);
    color: white;
  }

  .secondary-button {
    border: 1px solid var(--text);
    color: var(--text);
  }

  .portrait-slider {
  position: relative;

  width: 100%;
  aspect-ratio: 0.78;

  overflow: hidden;

  border-radius: 30px;

  background: #d7d8cc;
}

.slides {
  position: relative;

  width: 100%;
  height: 100%;
}

.slide {
  position: absolute;

  top: 0;
  left: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  opacity: 0;

  transition:
    opacity 0.8s ease,
    transform 0.8s ease;

  transform: scale(1.02);
}

.slide.active {
  opacity: 1;
  transform: scale(1);
}


/* 左右按鈕 */

.slider-button {
  position: absolute;

  top: 50%;
  transform: translateY(-50%);

  z-index: 5;

  width: 44px;
  height: 44px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0;

  border: 1px solid rgba(255, 255, 255, 0.55);
  border-radius: 50%;

  background: rgba(23, 37, 31, 0.45);
  color: white;

  font-size: 30px;
  line-height: 1;

  cursor: pointer;

  opacity: 0;

  transition:
    opacity 0.25s ease,
    background 0.25s ease;
}

.portrait-slider:hover .slider-button {
  opacity: 1;
}

.slider-button:hover {
  background: rgba(23, 37, 31, 0.75);
}

.previous {
  left: 16px;
}

.next {
  right: 16px;
}


/* 下方圓點 */

.slider-dots {
  position: absolute;

  bottom: 18px;
  left: 50%;

  z-index: 5;

  display: flex;
  gap: 8px;

  transform: translateX(-50%);
}

.slider-dot {
  width: 9px;
  height: 9px;

  padding: 0;

  border: 1px solid white;
  border-radius: 50%;

  background: transparent;

  cursor: pointer;

  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.slider-dot.active {
  background: white;
  transform: scale(1.2);
}


/* 手機版 */

@media (max-width: 700px) {
  .portrait-slider {
    max-height: 600px;

    border-radius: 22px;
  }

  .slider-button {
    width: 40px;
    height: 40px;

    opacity: 1;

    font-size: 26px;
  }

  .previous {
    left: 12px;
  }

  .next {
    right: 12px;
  }

  .slider-dots {
    bottom: 14px;
  }
}

  @media (max-width: 850px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 55px;
    }

    .portrait {
      max-width: 500px;
    }
  }

  @media (max-width: 700px) {
    .home {
      width: calc(100% - 40px);
    }

    .hero {
      min-height: auto;

      padding: 60px 0 80px;
    }

    h1 {
      font-size: clamp(64px, 21vw, 92px);
    }

    .english-name {
      font-size: 28px;
    }

    .position {
      margin-top: 38px;
      font-size: 18px;
    }

    .description {
      margin-top: 30px;
      font-size: 16px;
    }
  }
</style>
<script is:inline>
  function setupProfessorSlider() {
    const slider =
      document.getElementById('professor-slider');

    if (!slider) return;

    const slides =
      slider.querySelectorAll('[data-slide]');

    const dots =
      slider.querySelectorAll('[data-dot]');

    const previousButton =
      slider.querySelector('.previous');

    const nextButton =
      slider.querySelector('.next');

    let current = 0;
    let timer;

    function showSlide(index) {
      current =
        (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        slide.classList.toggle(
          'active',
          i === current
        );
      });

      dots.forEach((dot, i) => {
        dot.classList.toggle(
          'active',
          i === current
        );
      });
    }

    function nextSlide() {
      showSlide(current + 1);
    }

    function previousSlide() {
      showSlide(current - 1);
    }

    function startAutoPlay() {
      clearInterval(timer);

      timer = setInterval(
        nextSlide,
        5000
      );
    }

    previousButton?.addEventListener(
      'click',
      () => {
        previousSlide();
        startAutoPlay();
      }
    );

    nextButton?.addEventListener(
      'click',
      () => {
        nextSlide();
        startAutoPlay();
      }
    );

    dots.forEach((dot, index) => {
      dot.addEventListener(
        'click',
        () => {
          showSlide(index);
          startAutoPlay();
        }
      );
    });

    slider.addEventListener(
      'mouseenter',
      () => clearInterval(timer)
    );

    slider.addEventListener(
      'mouseleave',
      startAutoPlay
    );

    showSlide(0);
    startAutoPlay();
  }

  setupProfessorSlider();
</script>