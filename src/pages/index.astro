---
import BaseLayout from '../layouts/BaseLayout.astro';

const base =
  import.meta.env.BASE_URL.replace(/\/$/, '');

const profileImage =
  `${base}/professor.jpg`;
---

<BaseLayout
  title="王雅萍 Ong Nga Ping｜國立政治大學民族學系"
  description="國立政治大學民族學系王雅萍副教授個人網站"
>
  <main class="home">

    <section class="hero">
      <div class="hero-content">

        <p class="eyebrow">
          <span data-lang="zh">
            國立政治大學 · 民族學系
          </span>

          <span data-lang="en">
            Department of Ethnology · National Chengchi University
          </span>
        </p>

        <h1>王雅萍</h1>

        <p class="english-name">
          Ong Nga Ping
        </p>

        <p class="position">
          <span data-lang="zh">
            副教授｜社會科學學院民族學系
          </span>

          <span data-lang="en">
            Associate Professor · Department of Ethnology
          </span>
        </p>

        <p class="description">
          <span data-lang="zh">
            研究與教學聚焦民族教育、臺灣民族史、
            東南亞民族與現況、社區營造與民族學研究方法。
          </span>

          <span data-lang="en">
            Research and teaching interests include ethnic and
            Indigenous education, ethnic history of Taiwan,
            contemporary Southeast Asia, community engagement,
            and research methods in ethnology.
          </span>
        </p>

        <div class="actions">
          <a
            class="primary-button"
            href={`${base}/research/`}
          >
            <span data-lang="zh">查看研究</span>
            <span data-lang="en">Research</span>
          </a>

          <a
            class="secondary-button"
            href={`${base}/contact/`}
          >
            <span data-lang="zh">聯絡王老師</span>
            <span data-lang="en">Contact</span>
          </a>
        </div>

      </div>

      <div class="portrait">
        <img
          src={profileImage}
          alt="王雅萍副教授"
        />
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .home {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .hero {
    min-height: calc(100vh - 103px);

    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    align-items: center;

    gap: 90px;

    padding: 90px 0 110px;
  }

  .hero-content {
    max-width: 760px;
  }

  .eyebrow {
    margin: 0 0 30px;

    color: var(--brown);

    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;

    font-family: Georgia, "Noto Serif TC", serif;

    color: var(--text);

    font-size: clamp(72px, 10vw, 132px);
    font-weight: 500;
    line-height: 0.95;
  }

  .english-name {
    margin: 26px 0 0;

    color: var(--green);

    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;

    letter-spacing: 0.04em;
  }

  .position {
    margin: 52px 0 0;

    color: var(--text-secondary);

    font-size: 23px;
    line-height: 1.6;
  }

  .description {
    max-width: 750px;

    margin: 42px 0 0;

    color: var(--text-secondary);

    font-size: 19px;
    line-height: 1.9;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;

    gap: 14px;

    margin-top: 40px;
  }

  .actions a {
    padding: 14px 24px;

    border-radius: 999px;

    text-decoration: none;
    font-weight: 700;
  }

  .primary-button {
    background: var(--green);
    color: white;
  }

  .secondary-button {
    border: 1px solid var(--text);
    color: var(--text);
  }

  .portrait {
    width: 100%;
  }

  .portrait img {
    width: 100%;
    aspect-ratio: 0.78;

    object-fit: cover;

    border-radius: 30px;

    background: #d7d8cc;
  }

  @media (max-width: 850px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 55px;
    }

    .portrait {
      max-width: 500px;
    }
  }

  @media (max-width: 700px) {
    .home {
      width: calc(100% - 40px);
    }

    .hero {
      min-height: auto;

      padding: 60px 0 80px;
    }

    h1 {
      font-size: clamp(64px, 21vw, 92px);
    }

    .english-name {
      font-size: 28px;
    }

    .position {
      margin-top: 38px;
      font-size: 18px;
    }

    .description {
      margin-top: 30px;
      font-size: 16px;
    }
  }
</style>