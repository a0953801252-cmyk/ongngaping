---
import BaseLayout from '../layouts/BaseLayout.astro';

const publications = [
  {
    year: '2025',
    typeZh: '會議論文',
    typeEn: 'Conference Paper',
    titleZh:
      '教育領導與社會責任：原住民族語言發展法通過後新北市烏來區校長領導與語言韌性治理',
    titleEn:
      'Educational Leadership and Social Responsibility: School Leadership and Language Resilience Governance in Wulai after the Indigenous Languages Development Act',
  },

  {
    year: '2025',
    typeZh: '會議論文',
    typeEn: 'Conference Paper',
    titleZh:
      '不可能的超級任務：劉氏家廟文資的爭取歷程',
    titleEn:
      'An Impossible Mission: The Process of Seeking Cultural Heritage Recognition for the Liu Ancestral Temple',
  },

  {
    year: '2024',
    typeZh: '專書篇章',
    typeEn: 'Book Chapter',
    titleZh:
      '韓道長與發一組泰國道務發展',
    titleEn:
      'Han Daozhang and the Development of the Fayi Group in Thailand',
  },

  {
    year: '2024',
    typeZh: '專書篇章',
    typeEn: 'Book Chapter',
    titleZh:
      '族譜所見的新店十四張劉姓家族通婚網絡與婚俗',
    titleEn:
      'Marriage Networks and Customs of the Liu Family in Shisizhang, Xindian, as Seen through Genealogies',
  },

  {
    year: '2024',
    typeZh: '專書篇章',
    typeEn: 'Book Chapter',
    titleZh:
      '一起為本土語文課綱打拼的日子',
    titleEn:
      'Working Together for the Local Language Curriculum Guidelines',
  },

  {
    year: '2023',
    typeZh: '會議論文',
    typeEn: 'Conference Paper',
    titleZh:
      '新北市烏來區泰雅族的民族教育及工藝技藝傳承',
    titleEn:
      'Ethnic Education and the Transmission of Craft Skills among the Atayal in Wulai, New Taipei City',
  },

  {
    year: '2022',
    typeZh: '期刊文章',
    typeEn: 'Journal Article',
    titleZh:
      '迎接全民原教時代：談全民原教在高等教育端的推動',
    titleEn:
      'Toward Indigenous Education for All: Promoting Indigenous Education in Higher Education',
  },

  {
    year: '2021',
    typeZh: '期刊文章',
    typeEn: 'Journal Article',
    titleZh:
      '從九年一貫到十二年國教的原住民族語文領域綱要',
    titleEn:
      'Indigenous Language Curriculum Guidelines from the Nine-Year Curriculum to the Twelve-Year Basic Education System',
  },

  {
    year: '2021',
    typeZh: '專書篇章',
    typeEn: 'Book Chapter',
    titleZh:
      '土倉龍次郎家族與新店烏來地區的山林拓墾與原漢關係',
    titleEn:
      'The Tsuchikura Ryūjirō Family, Mountain Development, and Indigenous–Han Relations in Xindian and Wulai',
  },

  {
    year: '2020',
    typeZh: '期刊論文',
    typeEn: 'Journal Article',
    titleZh:
      '部落大学カリキュラムから烏来女性のエンパワーメント、工芸復興への展開',
    titleEn:
      'From Tribal College Curriculum to the Empowerment of Wulai Women and the Revival of Indigenous Crafts',
  },

  {
    year: '2019',
    typeZh: '專書',
    typeEn: 'Book',
    titleZh:
      '串：政治大學行動學術的實踐',
    titleEn:
      'Connecting: The Practice of Action Scholarship at National Chengchi University',
  },

  {
    year: '2019',
    typeZh: '專書篇章',
    typeEn: 'Book Chapter',
    titleZh:
      '織布文創產業與體驗經濟─台泰兩國一鄉村一特產（OTOP）推動之比較',
    titleEn:
      'Weaving, Cultural and Creative Industries, and the Experience Economy: A Comparison of OTOP Development in Taiwan and Thailand',
  },
];

const degreeTheses = [
  {
    year: '2009',
    degreeZh: '博士論文',
    degreeEn: 'Doctoral Dissertation',
    titleZh:
      '主體性的追尋：台灣鄉土教育理念的實踐與發展',
    titleEn:
      'In Search of Subjectivity: The Practice and Development of Local Education in Taiwan',
    url:
      'https://thesis.lib.nccu.edu.tw/detail/afdeeb812fdacc8aa5ea043c152ad0a8/',
  },

  {
    year: '1994',
    degreeZh: '碩士論文',
    degreeEn: "Master's Thesis",
    titleZh:
      '姓名與認同：以台灣原住民族姓名議題為中心',
    titleEn:
      "Names and Identity: On the Issue of Names among Taiwan Indigenous Peoples",
    url:
      'https://thesis.lib.nccu.edu.tw/detail/e501ea8bba5613892ed1f087f6bdb1b8/',
  },
];
---

<BaseLayout
  title="研究｜王雅萍 Ong Nga Ping"
  description="王雅萍副教授研究領域、學術著作與學位論文"
>
  <main class="research-page">

    <header class="page-header">
      <p class="eyebrow">
        RESEARCH
      </p>

      <h1>
        <span data-lang="zh">
          研究
        </span>

        <span data-lang="en">
          Research
        </span>
      </h1>

      <p class="intro">
        <span data-lang="zh">
          王雅萍副教授的研究涵蓋民族教育、臺灣民族史、
          東南亞民族與現況、社區營造與民族學研究方法，
          並長期關注原住民族語言與教育、文化復振、
          地方社會及跨國田野實踐。
        </span>

        <span data-lang="en">
          Ong Nga Ping's research covers ethnic and Indigenous
          education, ethnic history of Taiwan, Southeast Asian studies,
          community development, and research methods in ethnology,
          with continuing interests in Indigenous languages,
          cultural revitalization, local communities,
          and transnational fieldwork.
        </span>
      </p>
    </header>


    <!-- RESEARCH INTERESTS -->

    <section>
      <p class="section-label">
        RESEARCH INTERESTS
      </p>

      <h2>
        <span data-lang="zh">
          研究領域
        </span>

        <span data-lang="en">
          Research Interests
        </span>
      </h2>

      <div class="interest-grid">

        <article class="interest-card">
          <span class="number">01</span>

          <h3>
            <span data-lang="zh">
              民族與原住民族教育
            </span>

            <span data-lang="en">
              Ethnic & Indigenous Education
            </span>
          </h3>

          <p>
            <span data-lang="zh">
              原住民族教育政策、族語教育、
              課程發展與文化回應教學。
            </span>

            <span data-lang="en">
              Indigenous education policy,
              language education, curriculum development,
              and culturally responsive teaching.
            </span>
          </p>
        </article>

        <article class="interest-card">
          <span class="number">02</span>

          <h3>
            <span data-lang="zh">
              臺灣民族史
            </span>

            <span data-lang="en">
              Ethnic History of Taiwan
            </span>
          </h3>

          <p>
            <span data-lang="zh">
              從族群、地方及家族史角度探討臺灣歷史，
              包括原漢關係、地方文化與族譜研究。
            </span>

            <span data-lang="en">
              Taiwan history from ethnic, local,
              and family-history perspectives.
            </span>
          </p>
        </article>

        <article class="interest-card">
          <span class="number">03</span>

          <h3>
            <span data-lang="zh">
              東南亞民族與跨國研究
            </span>

            <span data-lang="en">
              Southeast Asia & Transnational Studies
            </span>
          </h3>

          <p>
            <span data-lang="zh">
              關注臺灣與東南亞之間的文化交流、
              社區發展與跨國田野實踐。
            </span>

            <span data-lang="en">
              Cultural exchange, community development,
              and transnational fieldwork between
              Taiwan and Southeast Asia.
            </span>
          </p>
        </article>

        <article class="interest-card">
          <span class="number">04</span>

          <h3>
            <span data-lang="zh">
              社區營造與文化復振
            </span>

            <span data-lang="en">
              Community Development & Cultural Revitalization
            </span>
          </h3>

          <p>
            <span data-lang="zh">
              探討文化技藝傳承、織布復振、
              社區行動與地方實踐。
            </span>

            <span data-lang="en">
              Cultural transmission, weaving revitalization,
              community action, and place-based practice.
            </span>
          </p>
        </article>

        <article class="interest-card">
          <span class="number">05</span>

          <h3>
            <span data-lang="zh">
              民族學研究方法
            </span>

            <span data-lang="en">
              Research Methods in Ethnology
            </span>
          </h3>

          <p>
            <span data-lang="zh">
              民族誌、田野調查、口述歷史、
              檔案研究與質性研究。
            </span>

            <span data-lang="en">
              Ethnography, fieldwork, oral history,
              archival research, and qualitative methods.
            </span>
          </p>
        </article>

      </div>
    </section>


    <!-- PUBLICATIONS -->

    <section>
      <p class="section-label">
        SELECTED PUBLICATIONS
      </p>

      <div class="section-heading-row">

        <h2>
          <span data-lang="zh">
            研究著作與發表
          </span>

          <span data-lang="en">
            Selected Publications
          </span>
        </h2>

        <a
          class="text-link"
          href="https://ah.lib.nccu.edu.tw/scholar?id=350&locale=zh_TW&subtitle=all&title=items"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span data-lang="zh">
            完整著作紀錄 ↗
          </span>

          <span data-lang="en">
            Full Record ↗
          </span>
        </a>

      </div>

      <p class="section-intro">
        <span data-lang="zh">
          以下選列近年及與主要研究領域相關的期刊文章、
          專書篇章與會議論文。
        </span>

        <span data-lang="en">
          Selected recent publications and presentations
          related to major research themes are listed below.
        </span>
      </p>

      <div class="publication-list">
        {
          publications.map((item) => (
            <article class="publication-item">

              <div class="publication-year">
                {item.year}
              </div>

              <div class="publication-content">

                <div class="publication-type">
                  <span data-lang="zh">
                    {item.typeZh}
                  </span>

                  <span data-lang="en">
                    {item.typeEn}
                  </span>
                </div>

                <h3>
                  <span data-lang="zh">
                    {item.titleZh}
                  </span>

                  <span data-lang="en">
                    {item.titleEn}
                  </span>
                </h3>

              </div>

            </article>
          ))
        }
      </div>
    </section>


    <!-- DEGREE THESES -->

    <section>
      <p class="section-label">
        DEGREE THESES
      </p>

      <h2>
        <span data-lang="zh">
          學位論文
        </span>

        <span data-lang="en">
          Degree Theses
        </span>
      </h2>

      <div class="degree-grid">
        {
          degreeTheses.map((item) => (
            <a
              class="degree-card"
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
            >

              <div class="degree-top">
                <span class="year">
                  {item.year}
                </span>

                <span class="arrow">
                  ↗
                </span>
              </div>

              <p class="degree-type">
                <span data-lang="zh">
                  {item.degreeZh}
                </span>

                <span data-lang="en">
                  {item.degreeEn}
                </span>
              </p>

              <h3>
                <span data-lang="zh">
                  {item.titleZh}
                </span>

                <span data-lang="en">
                  {item.titleEn}
                </span>
              </h3>

            </a>
          ))
        }
      </div>
    </section>


    <!-- OFFICIAL SOURCES -->

    <section>
      <p class="section-label">
        ACADEMIC RECORD
      </p>

      <h2>
        <span data-lang="zh">
          完整研究資料
        </span>

        <span data-lang="en">
          Complete Academic Record
        </span>
      </h2>

      <p class="source-description">
        <span data-lang="zh">
          最新及完整的研究與學術著作紀錄，
          請參閱國立政治大學官方資料。
        </span>

        <span data-lang="en">
          Please refer to official NCCU sources for
          the latest and complete academic record.
        </span>
      </p>

      <div class="source-buttons">

        <a
          href="https://ah.lib.nccu.edu.tw/scholar?id=350&locale=zh_TW"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span data-lang="zh">
            政大 Academic Hub ↗
          </span>

          <span data-lang="en">
            NCCU Academic Hub ↗
          </span>
        </a>

        <a
          href="https://ethnos.nccu.edu.tw/PageStaffing/Detail?fid=9618&id=2995"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span data-lang="zh">
            民族學系教師資料 ↗
          </span>

          <span data-lang="en">
            Faculty Profile ↗
          </span>
        </a>

      </div>
    </section>

  </main>
</BaseLayout>


<style>
  .research-page {
    width: min(1080px, calc(100% - 48px));

    margin: 0 auto;

    padding: 100px 0 130px;
  }

  .page-header {
    max-width: 850px;

    padding-bottom: 90px;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 14px;

    color: var(--brown);

    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 0;

    color: var(--text);

    font-size: clamp(52px, 8vw, 88px);
    line-height: 1.05;
  }

  .intro {
    max-width: 800px;

    margin: 36px 0 0;

    color: var(--text-secondary);

    font-size: 19px;
    line-height: 1.9;
  }

  section {
    padding: 64px 0;

    border-top: 1px solid var(--border);
  }

  h2 {
    margin: 8px 0 42px;

    color: var(--text);

    font-size: clamp(30px, 4vw, 40px);
  }

  .section-intro {
    max-width: 780px;

    margin: -15px 0 40px;

    color: var(--text-secondary);

    font-size: 16px;
    line-height: 1.85;
  }


  /* INTERESTS */

  .interest-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 20px;
  }

  .interest-card {
    padding: 28px;

    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .interest-card:last-child {
    grid-column: 1 / -1;
  }

  .number {
    display: block;

    margin-bottom: 28px;

    color: var(--brown);

    font-size: 13px;
    font-weight: 700;
  }

  .interest-card h3 {
    margin: 0;

    color: var(--text);

    font-size: 21px;
  }

  .interest-card p {
    margin: 15px 0 0;

    color: var(--text-secondary);

    font-size: 15px;
    line-height: 1.8;
  }


  /* PUBLICATIONS */

  .section-heading-row {
    display: flex;

    justify-content: space-between;
    align-items: flex-end;

    gap: 30px;
  }

  .text-link {
    margin-bottom: 42px;

    color: var(--green);

    text-decoration: none;

    font-size: 14px;
    font-weight: 700;
  }

  .publication-list {
    border-top: 1px solid var(--border);
  }

  .publication-item {
    display: grid;

    grid-template-columns: 110px 1fr;

    gap: 30px;

    padding: 28px 0;

    border-bottom: 1px solid var(--border);
  }

  .publication-year {
    color: var(--brown);

    font-weight: 700;
  }

  .publication-type {
    margin-bottom: 8px;

    color: var(--green);

    font-size: 12px;
    font-weight: 700;
  }

  .publication-content h3 {
    margin: 0;

    font-size: 18px;
    line-height: 1.65;
  }


  /* DEGREE */

  .degree-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 20px;
  }

  .degree-card {
    min-height: 260px;

    padding: 30px;

    border: 1px solid var(--border);
    border-radius: 16px;

    color: var(--text);

    text-decoration: none;

    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .degree-card:hover {
    border-color: var(--green);

    transform: translateY(-3px);
  }

  .degree-top {
    display: flex;

    justify-content: space-between;

    margin-bottom: 45px;
  }

  .year {
    color: var(--brown);

    font-weight: 700;
  }

  .arrow {
    color: var(--green);

    font-size: 20px;
  }

  .degree-type {
    color: var(--green);

    font-size: 13px;
    font-weight: 700;
  }

  .degree-card h3 {
    font-size: 20px;
    line-height: 1.65;
  }


  /* SOURCES */

  .source-description {
    max-width: 720px;

    color: var(--text-secondary);

    font-size: 17px;
    line-height: 1.8;
  }

  .source-buttons {
    display: flex;
    flex-wrap: wrap;

    gap: 12px;

    margin-top: 28px;
  }

  .source-buttons a {
    padding: 13px 20px;

    border: 1px solid var(--green);
    border-radius: 999px;

    color: var(--green);

    text-decoration: none;
    font-weight: 700;
  }

  .source-buttons a:hover {
    background: var(--green);

    color: var(--background);
  }


  @media (max-width: 850px) {
    .interest-grid,
    .degree-grid {
      grid-template-columns: 1fr;
    }

    .interest-card:last-child {
      grid-column: auto;
    }

    .section-heading-row {
      flex-direction: column;
      align-items: flex-start;

      gap: 0;
    }

    .text-link {
      margin-top: -25px;
      margin-bottom: 35px;
    }
  }


  @media (max-width: 700px) {
    .research-page {
      width: calc(100% - 40px);

      padding: 60px 0 80px;
    }

    .page-header {
      padding-bottom: 60px;
    }

    .intro {
      font-size: 16px;
    }

    section {
      padding: 45px 0;
    }

    .publication-item {
      grid-template-columns: 1fr;

      gap: 10px;

      padding: 24px 0;
    }

    .publication-content h3 {
      font-size: 16px;
    }

    .degree-card {
      min-height: auto;

      padding: 24px;
    }

    .source-buttons {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>