---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="研究｜王雅萍 Ong Nga Ping"
  description="王雅萍副教授研究領域"
>
  <main class="page">

    <header class="page-header">
      <p class="eyebrow">RESEARCH</p>

      <h1>
        <span data-lang="zh">研究</span>
        <span data-lang="en">Research</span>
      </h1>
    </header>

    <section>
      <p class="section-label">RESEARCH INTERESTS</p>

      <h2>
        <span data-lang="zh">研究領域</span>
        <span data-lang="en">Research Interests</span>
      </h2>

      <div class="list">

        <article>
          <span class="number">01</span>

          <div>
            <h3>
              <span data-lang="zh">民族教育</span>
              <span data-lang="en">
                Ethnic and Indigenous Education
              </span>
            </h3>
          </div>
        </article>

        <article>
          <span class="number">02</span>

          <div>
            <h3>
              <span data-lang="zh">臺灣民族史</span>
              <span data-lang="en">
                Ethnic History of Taiwan
              </span>
            </h3>
          </div>
        </article>

        <article>
          <span class="number">03</span>

          <div>
            <h3>
              <span data-lang="zh">
                東南亞民族與現況
              </span>

              <span data-lang="en">
                Ethnic Groups and Contemporary Southeast Asia
              </span>
            </h3>
          </div>
        </article>

        <article>
          <span class="number">04</span>

          <div>
            <h3>
              <span data-lang="zh">社區營造</span>
              <span data-lang="en">
                Community Development
              </span>
            </h3>
          </div>
        </article>

        <article>
          <span class="number">05</span>

          <div>
            <h3>
              <span data-lang="zh">
                民族學研究方法
              </span>

              <span data-lang="en">
                Research Methods in Ethnology
              </span>
            </h3>
          </div>
        </article>

      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .page {
    width: min(1050px, calc(100% - 48px));
    margin: 0 auto;
    padding: 100px 0 130px;
  }

  .page-header {
    padding-bottom: 80px;
  }

  .eyebrow,
  .section-label {
    color: var(--brown);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 12px 0 0;
    font-size: clamp(48px, 7vw, 82px);
  }

  section {
    padding: 56px 0;
    border-top: 1px solid var(--border);
  }

  h2 {
    font-size: 34px;
  }

  article {
    display: grid;
    grid-template-columns: 70px 1fr;

    gap: 20px;

    padding: 30px 0;

    border-top: 1px solid var(--border);
  }

  .number {
    color: var(--brown);
    font-size: 14px;
    font-weight: 700;
  }

  h3 {
    margin: 0;
    font-size: 21px;
  }

  @media (max-width: 700px) {
    .page {
      width: calc(100% - 40px);
      padding: 60px 0 80px;
    }

    article {
      grid-template-columns: 40px 1fr;
    }
  }
</style>