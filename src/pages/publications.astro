---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="著作｜王雅萍 Ong Nga Ping"
  description="王雅萍副教授學術著作"
>
  <main class="page">

    <header class="page-header">
      <p class="eyebrow">PUBLICATIONS</p>

      <h1>
        <span data-lang="zh">著作</span>
        <span data-lang="en">Publications</span>
      </h1>
    </header>

    <section>
      <p class="section-label">JOURNAL ARTICLES</p>

      <h2>
        <span data-lang="zh">期刊論文</span>
        <span data-lang="en">Journal Articles</span>
      </h2>
    </section>

    <section>
      <p class="section-label">BOOKS & CHAPTERS</p>

      <h2>
        <span data-lang="zh">專書與專書篇章</span>
        <span data-lang="en">
          Books and Book Chapters
        </span>
      </h2>
    </section>

    <section>
      <p class="section-label">CONFERENCE PAPERS</p>

      <h2>
        <span data-lang="zh">會議論文</span>
        <span data-lang="en">Conference Papers</span>
      </h2>
    </section>

    <section>
      <p class="section-label">OFFICIAL PROFILE</p>

      <h2>
        <span data-lang="zh">完整著作資料</span>
        <span data-lang="en">
          Complete Publication Record
        </span>
      </h2>

      <a
        class="button"
        href="https://ethnos.nccu.edu.tw/PageStaffing/Detail?fid=9618&id=2995"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-lang="zh">
          查看民族學系官方資料 ↗
        </span>

        <span data-lang="en">
          Official Faculty Profile ↗
        </span>
      </a>
    </section>

  </main>
</BaseLayout>

<style>
  .page {
    width: min(1050px, calc(100% - 48px));
    margin: 0 auto;
    padding: 100px 0 130px;
  }

  .page-header {
    padding-bottom: 80px;
  }

  .eyebrow,
  .section-label {
    color: var(--brown);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 12px 0 0;
    font-size: clamp(48px, 7vw, 82px);
  }

  section {
    padding: 56px 0;
    border-top: 1px solid var(--border);
  }

  h2 {
    font-size: 34px;
  }

  .button {
    display: inline-block;

    margin-top: 15px;
    padding: 14px 22px;

    border: 1px solid var(--green);
    border-radius: 999px;

    color: var(--green);
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 700px) {
    .page {
      width: calc(100% - 40px);
      padding: 60px 0 80px;
    }
  }
</style>