---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="教學｜王雅萍 Ong Nga Ping"
  description="國立政治大學民族學系王雅萍副教授教學與課程資訊"
>
  <main class="teaching-page">
    <header class="page-header">
      <p class="eyebrow">TEACHING</p>
      <h1>教學</h1>
      <p class="subtitle">Teaching</p>
    </header>

    <section>
      <p class="section-label">COURSES</p>
      <h2>課程</h2>

      <div class="course-list">
        <article class="course-item">
          <div class="course-number">01</div>

          <div>
            <h3>原住民族教育</h3>
            <p class="english">Indigenous Education</p>
          </div>
        </article>

        <article class="course-item">
          <div class="course-number">02</div>

          <div>
            <h3>民族學相關課程</h3>
            <p class="english">
              Courses in Ethnology and Indigenous Studies
            </p>
          </div>
        </article>
      </div>
    </section>

    <section>
      <p class="section-label">TEACHING INTERESTS</p>
      <h2>教學領域</h2>

      <div class="interest-grid">
        <div class="interest-item">
          <h3>民族教育</h3>
          <p>Ethnic and Indigenous Education</p>
        </div>

        <div class="interest-item">
          <h3>臺灣民族史</h3>
          <p>Ethnic History of Taiwan</p>
        </div>

        <div class="interest-item">
          <h3>東南亞民族與現況</h3>
          <p>Ethnic Groups and Contemporary Southeast Asia</p>
        </div>

        <div class="interest-item">
          <h3>民族學研究方法</h3>
          <p>Research Methods in Ethnology</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .teaching-page {
    width: min(1050px, calc(100% - 48px));
    margin: 0 auto;
    padding: 100px 0 130px;
  }

  .page-header {
    padding-bottom: 80px;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 14px;
    color: var(--brown);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(48px, 7vw, 82px);
    line-height: 1.1;
  }

  .subtitle {
    margin: 18px 0 0;
    color: var(--green);
    font-size: 22px;
    font-weight: 600;
  }

  section {
    padding: 56px 0;
    border-top: 1px solid var(--border);
  }

  h2 {
    margin: 8px 0 38px;
    color: var(--text);
    font-size: clamp(28px, 4vw, 38px);
  }

  h3 {
    margin: 0 0 6px;
    color: var(--text);
    font-size: 21px;
  }

  .english {
    margin: 0;
    color: var(--text-secondary);
    font-size: 15px;
  }

  .course-list {
    display: flex;
    flex-direction: column;
  }

  .course-item {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 25px;
    padding: 30px 0;
    border-top: 1px solid var(--border);
  }

  .course-number {
    color: var(--brown);
    font-size: 14px;
    font-weight: 700;
  }

  .interest-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .interest-item {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .interest-item p {
    margin: 8px 0 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 700px) {
    .teaching-page {
      width: calc(100% - 40px);
      padding: 60px 0 80px;
    }

    .page-header {
      padding-bottom: 55px;
    }

    section {
      padding: 40px 0;
    }

    .course-item {
      grid-template-columns: 40px 1fr;
      gap: 12px;
    }

    .interest-grid {
      grid-template-columns: 1fr;
    }

    .subtitle {
      font-size: 18px;
    }
  }
</style>
    