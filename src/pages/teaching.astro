---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="教學｜王雅萍 Ong Nga Ping"
  description="王雅萍副教授教學資訊"
>
  <main class="page">

    <header class="page-header">
      <p class="eyebrow">TEACHING</p>

      <h1>
        <span data-lang="zh">教學</span>
        <span data-lang="en">Teaching</span>
      </h1>
    </header>

    <section>
      <p class="section-label">COURSES</p>

      <h2>
        <span data-lang="zh">課程</span>
        <span data-lang="en">Courses</span>
      </h2>

      <div class="course">

        <div>
          <span class="number">01</span>
        </div>

        <div>
          <h3>
            <span data-lang="zh">
              原住民族教育
            </span>

            <span data-lang="en">
              Indigenous Education
            </span>
          </h3>
        </div>

      </div>
    </section>

    <section>
      <p class="section-label">TEACHING INTERESTS</p>

      <h2>
        <span data-lang="zh">教學領域</span>
        <span data-lang="en">Teaching Interests</span>
      </h2>

      <div class="grid">

        <div>
          <span data-lang="zh">民族教育</span>
          <span data-lang="en">
            Ethnic and Indigenous Education
          </span>
        </div>

        <div>
          <span data-lang="zh">臺灣民族史</span>
          <span data-lang="en">
            Ethnic History of Taiwan
          </span>
        </div>

        <div>
          <span data-lang="zh">
            東南亞民族與現況
          </span>

          <span data-lang="en">
            Contemporary Southeast Asia
          </span>
        </div>

        <div>
          <span data-lang="zh">
            民族學研究方法
          </span>

          <span data-lang="en">
            Research Methods in Ethnology
          </span>
        </div>

      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .page {
    width: min(1050px, calc(100% - 48px));
    margin: 0 auto;
    padding: 100px 0 130px;
  }

  .page-header {
    padding-bottom: 80px;
  }

  .eyebrow,
  .section-label {
    color: var(--brown);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 12px 0 0;
    font-size: clamp(48px, 7vw, 82px);
  }

  section {
    padding: 56px 0;
    border-top: 1px solid var(--border);
  }

  h2 {
    font-size: 34px;
  }

  .course {
    display: grid;
    grid-template-columns: 70px 1fr;

    padding: 30px 0;

    border-top: 1px solid var(--border);
  }

  .number {
    color: var(--brown);
    font-weight: 700;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    gap: 20px;
  }

  .grid > div {
    padding: 28px;

    border: 1px solid var(--border);
    border-radius: 12px;

    font-size: 18px;
  }

  @media (max-width: 700px) {
    .page {
      width: calc(100% - 40px);
      padding: 60px 0 80px;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>