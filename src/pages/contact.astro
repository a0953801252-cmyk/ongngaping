---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="聯絡｜王雅萍 Ong Nga Ping"
  description="王雅萍副教授聯絡資訊"
>
  <main class="page">

    <header class="page-header">
      <p class="eyebrow">CONTACT</p>

      <h1>
        <span data-lang="zh">聯絡</span>
        <span data-lang="en">Contact</span>
      </h1>
    </header>

    <section>
      <p class="section-label">AFFILIATION</p>

      <h2>
        <span data-lang="zh">任職單位</span>
        <span data-lang="en">Affiliation</span>
      </h2>

      <p>
        <span data-lang="zh">
          國立政治大學社會科學學院民族學系
        </span>

        <span data-lang="en">
          Department of Ethnology,
          College of Social Sciences,
          National Chengchi University
        </span>
      </p>
    </section>

    <section>
      <p class="section-label">POSITION</p>

      <h2>
        <span data-lang="zh">職稱</span>
        <span data-lang="en">Position</span>
      </h2>

      <p>
        <span data-lang="zh">副教授</span>
        <span data-lang="en">Associate Professor</span>
      </p>
    </section>

    <section>
      <p class="section-label">ADDRESS</p>

      <h2>
        <span data-lang="zh">學校地址</span>
        <span data-lang="en">Address</span>
      </h2>

      <p>
        <span data-lang="zh">
          116011 臺北市文山區指南路二段 64 號
        </span>

        <span data-lang="en">
          No. 64, Sec. 2, Zhinan Rd.,
          Wenshan Dist., Taipei City 116011, Taiwan
        </span>
      </p>
    </section>

    <section>
      <p class="section-label">OFFICIAL PROFILE</p>

      <h2>
        <span data-lang="zh">官方資料</span>
        <span data-lang="en">Official Profile</span>
      </h2>

      <a
        class="button"
        href="https://ethnos.nccu.edu.tw/PageStaffing/Detail?fid=9618&id=2995"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-lang="zh">
          民族學系教師資料 ↗
        </span>

        <span data-lang="en">
          Faculty Profile ↗
        </span>
      </a>
    </section>

  </main>
</BaseLayout>

<style>
  .page {
    width: min(1050px, calc(100% - 48px));
    margin: 0 auto;
    padding: 100px 0 130px;
  }

  .page-header {
    padding-bottom: 80px;
  }

  .eyebrow,
  .section-label {
    color: var(--brown);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 12px 0 0;
    font-size: clamp(48px, 7vw, 82px);
  }

  section {
    padding: 56px 0;
    border-top: 1px solid var(--border);
  }

  h2 {
    font-size: 34px;
  }

  p {
    max-width: 760px;

    color: var(--text-secondary);

    font-size: 18px;
    line-height: 1.8;
  }

  .button {
    display: inline-block;

    margin-top: 15px;
    padding: 14px 22px;

    border: 1px solid var(--green);
    border-radius: 999px;

    color: var(--green);
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 700px) {
    .page {
      width: calc(100% - 40px);
      padding: 60px 0 80px;
    }

    p {
      font-size: 16px;
    }
  }
</style>