---
import Navbar from '../components/Navbar.astro';
---

<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="國立政治大學民族學系王雅萍副教授個人網站"
    />

    <title>關於｜王雅萍 Ong Nga Ping</title>
  </head>

  <body>
    <Navbar />

    <main>
      <p class="eyebrow">ABOUT</p>

      <h1>關於王雅萍</h1>

      <section>
        <h2>現職</h2>

        <p>
          國立政治大學社會科學學院民族學系副教授
        </p>
      </section>

      <section>
        <h2>研究領域</h2>

        <p>
          民族教育、臺灣民族史、東南亞民族與現況、
          社區營造、民族學研究方法。
        </p>
      </section>

      <section>
        <h2>學歷</h2>

        <ul>
          <li>國立政治大學教育學博士</li>
          <li>國立政治大學民族學碩士</li>
          <li>國立成功大學歷史學學士</li>
        </ul>
      </section>

      <section>
        <h2>About</h2>

        <p>
          Ong Nga Ping is an Associate Professor in the Department of
          Ethnology at National Chengchi University.
        </p>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f4efe6;
    color: #17251f;
    font-family:
      Arial,
      "Noto Sans TC",
      sans-serif;
  }

  main {
    width: min(1000px, calc(100% - 48px));
    margin: 0 auto;
    padding: 100px 0 120px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #a85d38;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0 0 72px;
    font-size: clamp(46px, 7vw, 82px);
    line-height: 1.1;
    font-weight: 700;
  }

  section {
    max-width: 760px;
    padding: 36px 0;
    border-top: 1px solid #d8d1c5;
  }

  h2 {
    margin: 0 0 18px;
    font-size: 24px;
  }

  p,
  li {
    font-size: 18px;
    line-height: 1.9;
    color: #59635e;
  }

  ul {
    padding-left: 24px;
  }

  @media (max-width: 750px) {
    main {
      width: min(100% - 40px, 1000px);
      padding: 64px 0 80px;
    }

    h1 {
      margin-bottom: 48px;
    }

    section {
      padding: 28px 0;
    }

    p,
    li {
      font-size: 16px;
    }
  }
</style>