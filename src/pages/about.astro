---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="關於｜王雅萍 Ong Nga Ping"
  description="王雅萍副教授學歷、經歷與研究專長"
>
  <main class="page">

    <header class="page-header">
      <p class="eyebrow">ABOUT</p>

      <h1>
        <span data-lang="zh">關於</span>
        <span data-lang="en">About</span>
      </h1>
    </header>

    <section>
      <p class="section-label">CURRENT POSITION</p>

      <h2>
        <span data-lang="zh">現職</span>
        <span data-lang="en">Current Position</span>
      </h2>

      <h3>
        <span data-lang="zh">
          國立政治大學社會科學學院民族學系
        </span>

        <span data-lang="en">
          Department of Ethnology,
          College of Social Sciences,
          National Chengchi University
        </span>
      </h3>

      <p>
        <span data-lang="zh">副教授</span>
        <span data-lang="en">Associate Professor</span>
      </p>
    </section>

    <section>
      <p class="section-label">RESEARCH INTERESTS</p>

      <h2>
        <span data-lang="zh">研究專長</span>
        <span data-lang="en">Research Interests</span>
      </h2>

      <p class="body-text">
        <span data-lang="zh">
          民族教育、臺灣民族史、東南亞民族與現況、
          社區營造、民族學研究方法。
        </span>

        <span data-lang="en">
          Ethnic and Indigenous education, ethnic history of Taiwan,
          contemporary Southeast Asia, community development,
          and research methods in ethnology.
        </span>
      </p>
    </section>

    <section>
      <p class="section-label">EDUCATION</p>

      <h2>
        <span data-lang="zh">學歷</span>
        <span data-lang="en">Education</span>
      </h2>

      <div class="timeline">

        <div class="timeline-item">
          <div class="side">
            <span data-lang="zh">博士</span>
            <span data-lang="en">Ph.D.</span>
          </div>

          <div>
            <h3>
              <span data-lang="zh">國立政治大學</span>
              <span data-lang="en">
                National Chengchi University
              </span>
            </h3>

            <p>
              <span data-lang="zh">教育學系博士</span>
              <span data-lang="en">
                Ph.D. in Education
              </span>
            </p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="side">
            <span data-lang="zh">碩士</span>
            <span data-lang="en">M.A.</span>
          </div>

          <div>
            <h3>
              <span data-lang="zh">國立政治大學</span>
              <span data-lang="en">
                National Chengchi University
              </span>
            </h3>

            <p>
              <span data-lang="zh">民族學系碩士</span>
              <span data-lang="en">
                M.A. in Ethnology
              </span>
            </p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="side">
            <span data-lang="zh">學士</span>
            <span data-lang="en">B.A.</span>
          </div>

          <div>
            <h3>
              <span data-lang="zh">國立成功大學</span>
              <span data-lang="en">
                National Cheng Kung University
              </span>
            </h3>

            <p>
              <span data-lang="zh">歷史學系學士</span>
              <span data-lang="en">
                B.A. in History
              </span>
            </p>
          </div>
        </div>

      </div>
    </section>

    <section>
      <p class="section-label">EXPERIENCE</p>

      <h2>
        <span data-lang="zh">經歷</span>
        <span data-lang="en">Experience</span>
      </h2>

      <div class="timeline">

        <div class="timeline-item">
          <div class="side">2023–2026</div>

          <div>
            <h3>
              <span data-lang="zh">
                國立政治大學大學社會責任辦公室
              </span>

              <span data-lang="en">
                University Social Responsibility Office,
                National Chengchi University
              </span>
            </h3>

            <p>
              <span data-lang="zh">副執行長</span>
              <span data-lang="en">
                Deputy Executive Director
              </span>
            </p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="side">2016–2021</div>

          <div>
            <h3>
              <span data-lang="zh">
                國立政治大學民族學系
              </span>

              <span data-lang="en">
                Department of Ethnology,
                National Chengchi University
              </span>
            </h3>

            <p>
              <span data-lang="zh">系主任</span>
              <span data-lang="en">Department Chair</span>
            </p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="side">2015–2017</div>

          <div>
            <h3>
              <span data-lang="zh">
                國立政治大學社會實踐辦公室
              </span>

              <span data-lang="en">
                Office of Social Engagement,
                National Chengchi University
              </span>
            </h3>

            <p>
              <span data-lang="zh">副教授</span>
              <span data-lang="en">Associate Professor</span>
            </p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="side">2009–2012</div>

          <div>
            <h3>
              <span data-lang="zh">
                國立政治大學教學發展中心規劃研究組
              </span>

              <span data-lang="en">
                Center for Teaching and Learning Development,
                National Chengchi University
              </span>
            </h3>

            <p>
              <span data-lang="zh">組長</span>
              <span data-lang="en">Section Chief</span>
            </p>
          </div>
        </div>

      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .page {
    width: min(1050px, calc(100% - 48px));
    margin: 0 auto;
    padding: 100px 0 130px;
  }

  .page-header {
    padding-bottom: 80px;
  }

  .eyebrow,
  .section-label {
    color: var(--brown);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 12px 0 0;
    font-size: clamp(48px, 7vw, 82px);
  }

  section {
    padding: 56px 0;
    border-top: 1px solid var(--border);
  }

  h2 {
    font-size: 34px;
  }

  h3 {
    margin-bottom: 8px;
    font-size: 21px;
  }

  p {
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .body-text {
    max-width: 760px;
    font-size: 18px;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 170px 1fr;

    gap: 40px;

    padding: 30px 0;

    border-top: 1px solid var(--border);
  }

  .side {
    color: var(--green);
    font-weight: 700;
  }

  @media (max-width: 700px) {
    .page {
      width: calc(100% - 40px);
      padding: 60px 0 80px;
    }

    .timeline-item {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>