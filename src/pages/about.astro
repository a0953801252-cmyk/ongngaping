---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="關於｜王雅萍 Ong Nga Ping"
  description="國立政治大學民族學系王雅萍副教授學歷、經歷與研究專長"
>
  <main class="about-page">
    <header class="page-header">
      <p class="eyebrow">ABOUT</p>
      <h1>關於王雅萍</h1>
      <p class="subtitle">About Ong Nga Ping</p>
    </header>

    <!-- 現職 -->
    <section>
      <p class="section-label">CURRENT POSITION</p>
      <h2>現職</h2>

      <div class="content-block">
        <h3>國立政治大學</h3>
        <p class="primary-text">
          社會科學學院民族學系 副教授
        </p>
        <p class="english">
          Associate Professor, Department of Ethnology,
          College of Social Sciences, National Chengchi University
        </p>
      </div>
    </section>

    <!-- 研究專長 -->
    <section>
      <p class="section-label">RESEARCH INTERESTS</p>
      <h2>研究專長</h2>

      <div class="research-list">
        <div class="research-item">
          <span class="number">01</span>
          <div>
            <h3>民族教育</h3>
            <p class="english">Ethnic and Indigenous Education</p>
          </div>
        </div>

        <div class="research-item">
          <span class="number">02</span>
          <div>
            <h3>臺灣民族史</h3>
            <p class="english">Ethnic History of Taiwan</p>
          </div>
        </div>

        <div class="research-item">
          <span class="number">03</span>
          <div>
            <h3>東南亞民族與現況</h3>
            <p class="english">
              Ethnic Groups and Contemporary Southeast Asia
            </p>
          </div>
        </div>

        <div class="research-item">
          <span class="number">04</span>
          <div>
            <h3>社區營造</h3>
            <p class="english">
              Community Development and Social Engagement
            </p>
          </div>
        </div>

        <div class="research-item">
          <span class="number">05</span>
          <div>
            <h3>民族學研究方法</h3>
            <p class="english">
              Research Methods in Ethnology
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 學歷 -->
    <section>
      <p class="section-label">EDUCATION</p>
      <h2>學歷</h2>

      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-side">
            <span class="degree">博士</span>
            <span class="degree-en">Ph.D.</span>
          </div>

          <div class="timeline-content">
            <h3>國立政治大學</h3>
            <p class="primary-text">教育學系博士</p>
            <p class="english">
              Ph.D. in Education, National Chengchi University
            </p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-side">
            <span class="degree">碩士</span>
            <span class="degree-en">M.A.</span>
          </div>

          <div class="timeline-content">
            <h3>國立政治大學</h3>
            <p class="primary-text">民族學系碩士</p>
            <p class="english">
              M.A. in Ethnology, National Chengchi University
            </p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-side">
            <span class="degree">學士</span>
            <span class="degree-en">B.A.</span>
          </div>

          <div class="timeline-content">
            <h3>國立成功大學</h3>
            <p class="primary-text">歷史學系學士</p>
            <p class="english">
              B.A. in History, National Cheng Kung University
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 經歷 -->
    <section>
      <p class="section-label">EXPERIENCE</p>
      <h2>經歷</h2>

      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-side">
            <span class="year">2023–2026</span>
          </div>

          <div class="timeline-content">
            <h3>國立政治大學 大學社會責任辦公室</h3>
            <p class="primary-text">副執行長</p>
            <p class="english">
              Deputy Executive Director,
              University Social Responsibility Office
            </p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-side">
            <span class="year">2016–2021</span>
          </div>

          <div class="timeline-content">
            <h3>國立政治大學 民族學系</h3>
            <p class="primary-text">系主任</p>
            <p class="english">
              Chair, Department of Ethnology,
              National Chengchi University
            </p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-side">
            <span class="year">2015–2017</span>
          </div>

          <div class="timeline-content">
            <h3>國立政治大學 社會實踐辦公室</h3>
            <p class="primary-text">副教授</p>
            <p class="english">
              Associate Professor, Office of Social Engagement
            </p>
          </div>
        </div>

        <div class="timeline-item">
          <div class="timeline-side">
            <span class="year">2009–2012</span>
          </div>

          <div class="timeline-content">
            <h3>國立政治大學 教學發展中心規劃研究組</h3>
            <p class="primary-text">組長</p>
            <p class="english">
              Section Chief,
              Center for Teaching and Learning Development
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .about-page {
    width: min(1050px, calc(100% - 48px));
    margin: 0 auto;
    padding: 100px 0 130px;
  }

  .page-header {
    padding-bottom: 80px;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 14px;
    color: #a85d38;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin: 0;
    color: #17251f;
    font-size: clamp(48px, 7vw, 82px);
    font-weight: 700;
    line-height: 1.1;
  }

  .subtitle {
    margin: 18px 0 0;
    color: #2f6652;
    font-size: 22px;
    font-weight: 600;
  }

  section {
    padding: 56px 0;
    border-top: 1px solid #d8d1c5;
  }

  h2 {
    margin: 8px 0 38px;
    color: #17251f;
    font-size: clamp(28px, 4vw, 38px);
  }

  h3 {
    margin: 0 0 8px;
    color: #17251f;
    font-size: 21px;
    line-height: 1.5;
  }

  p {
    margin: 0;
  }

  .content-block {
    max-width: 720px;
  }

  .primary-text {
    margin-top: 6px;
    color: #59635e;
    font-size: 18px;
    line-height: 1.8;
  }

  .english {
    margin-top: 6px;
    color: #818780;
    font-size: 15px;
    line-height: 1.7;
  }

  /* 研究專長 */

  .research-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 48px;
  }

  .research-item {
    display: grid;
    grid-template-columns: 45px 1fr;
    gap: 18px;
    padding: 26px 0;
    border-top: 1px solid #d8d1c5;
  }

  .number {
    color: #a85d38;
    font-size: 13px;
    font-weight: 700;
  }

  /* 學歷、經歷 */

  .timeline {
    width: 100%;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 42px;
    padding: 32px 0;
    border-top: 1px solid #d8d1c5;
  }

  .timeline-side {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .degree,
  .year {
    color: #2f6652;
    font-size: 16px;
    font-weight: 700;
  }

  .degree-en {
    color: #818780;
    font-size: 13px;
  }

  .timeline-content {
    max-width: 680px;
  }

  /* 平板 */

  @media (max-width: 850px) {
    .research-list {
      grid-template-columns: 1fr;
    }
  }

  /* 手機 */

  @media (max-width: 700px) {
    .about-page {
      width: calc(100% - 40px);
      padding: 60px 0 80px;
    }

    .page-header {
      padding-bottom: 55px;
    }

    .subtitle {
      font-size: 18px;
    }

    section {
      padding: 40px 0;
    }

    h2 {
      margin-bottom: 28px;
    }

    .timeline-item {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 26px 0;
    }

    .timeline-side {
      flex-direction: row;
      align-items: center;
      gap: 10px;
    }

    .primary-text {
      font-size: 16px;
    }

    .english {
      font-size: 14px;
    }

    .research-item {
      grid-template-columns: 36px 1fr;
      gap: 10px;
    }
  }
</style>