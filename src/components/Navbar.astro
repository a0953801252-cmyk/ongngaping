---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
  <a class="brand" href={`${base}/`}>
    王雅萍 · Ong Nga Ping
  </a>

  <nav>
    <a href={`${base}/`}>首頁</a>
    <a href={`${base}/about/`}>關於</a>
    <a href={`${base}/research/`}>研究</a>
    <a href={`${base}/publications/`}>著作</a>
    <a href={`${base}/teaching/`}>教學</a>
    <a href={`${base}/contact/`}>聯絡</a>
  </nav>
</header>

<style>
.site-header {
  background: var(--background);
}

  .brand {
    color: #17251f;
    text-decoration: none;
    font-weight: 700;
    font-size: 18px;
  }

  nav {
    display: flex;
    gap: 28px;
    align-items: center;
  }

  nav a {
    color: #59635e;
    text-decoration: none;
    font-weight: 600;
  }

  nav a:hover {
    color: #2f6652;
  }

  @media (max-width: 750px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      padding: 20px 24px;
    }

    nav {
      flex-wrap: wrap;
      gap: 12px 20px;
    }

    nav a {
      font-size: 15px;
    }
  }
</style>