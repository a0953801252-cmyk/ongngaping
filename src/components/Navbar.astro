---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">

  <nav class="nav-links" aria-label="主要導覽">

    <a href={`${base}/`}>
      <span data-lang="zh">首頁</span>
      <span data-lang="en">Home</span>
    </a>

    <a href={`${base}/about/`}>
      <span data-lang="zh">關於</span>
      <span data-lang="en">About</span>
    </a>

    <a href={`${base}/research/`}>
      <span data-lang="zh">研究</span>
      <span data-lang="en">Research</span>
    </a>

    <a href={`${base}/publications/`}>
      <span data-lang="zh">指導學生</span>
      <span data-lang="en">Supervision</span>
    </a>

    <a href={`${base}/teaching/`}>
      <span data-lang="zh">教學</span>
      <span data-lang="en">Teaching</span>
    </a>

    <a href={`${base}/service/`}>
      <span data-lang="zh">社會服務</span>
      <span data-lang="en">Service</span>
    </a>

    <a href={`${base}/projects/`}>
      <span data-lang="zh">計畫參與</span>
      <span data-lang="en">Projects</span>
    </a>

    <a href={`${base}/contact/`}>
      <span data-lang="zh">聯絡</span>
      <span data-lang="en">Contact</span>
    </a>

    <button
      id="language-toggle"
      class="language-toggle"
      type="button"
      aria-label="切換語言"
    >
      EN
    </button>

  </nav>

</header>


<style>
  .site-header {
    width: 100%;

    display: flex;
    justify-content: flex-end;
    align-items: center;

    padding: 20px 4%;

    background: var(--background);
    border-bottom: 1px solid var(--border);

    position: relative;
    z-index: 100;
  }

  .nav-links {
    display: flex;
    justify-content: flex-end;
    align-items: center;

    gap: 20px;

    margin-left: auto;
  }

  .nav-links a {
    color: var(--text-secondary);

    text-decoration: none;

    font-size: 15px;
    font-weight: 600;

    white-space: nowrap;

    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--green);
  }

  .language-toggle {
    display: flex;
    justify-content: center;
    align-items: center;

    flex-shrink: 0;

    width: 52px;
    height: 52px;

    margin-left: 3px;

    background: transparent;
    color: var(--text);

    border: 1.5px solid var(--text);
    border-radius: 50%;

    font-size: 14px;
    font-weight: 700;

    cursor: pointer;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .language-toggle:hover {
    background: var(--green);
    border-color: var(--green);

    color: var(--background);
  }


  @media (max-width: 1100px) {
    .nav-links {
      gap: 13px;
    }

    .nav-links a {
      font-size: 13px;
    }

    .language-toggle {
      width: 46px;
      height: 46px;

      font-size: 12px;
    }
  }


  @media (max-width: 800px) {
    .site-header {
      padding: 16px 20px;
    }

    .nav-links {
      width: 100%;

      flex-wrap: wrap;
      justify-content: flex-end;

      gap: 10px 15px;
    }

    .language-toggle {
      width: 44px;
      height: 44px;
    }
  }
</style>


<script is:inline>
  function initializeLanguageButton() {
    const button =
      document.getElementById('language-toggle');

    if (!button) return;

    function updateButton() {
      const language =
        document.documentElement.dataset.language || 'zh';

      button.textContent =
        language === 'en'
          ? '中文'
          : 'EN';
    }

    updateButton();

    button.onclick = () => {
      const current =
        document.documentElement.dataset.language || 'zh';

      const next =
        current === 'zh'
          ? 'en'
          : 'zh';

      document.documentElement.dataset.language =
        next;

      document.documentElement.lang =
        next === 'en'
          ? 'en'
          : 'zh-Hant';

      localStorage.setItem(
        'site-language',
        next
      );

      updateButton();
    };
  }

  initializeLanguageButton();
</script>