---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
  <a class="brand" href={`${base}/`}>
    王雅萍 · Ong Nga Ping
  </a>

  <nav class="nav-links">
    <a href={`${base}/`}>首頁</a>
    <a href={`${base}/about/`}>關於</a>
    <a href={`${base}/research/`}>研究</a>
    <a href={`${base}/publications/`}>著作</a>
    <a href={`${base}/teaching/`}>教學</a>
    <a href={`${base}/contact/`}>聯絡</a>
  </nav>
</header>

<style>
  .site-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    padding: 28px 5%;

    background: var(--background);
    border-bottom: 1px solid var(--border);
  }

  .brand {
    color: var(--text);
    text-decoration: none;
    font-size: 18px;
    font-weight: 700;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 28px;

    margin-left: auto;
  }

  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;

    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--green);
  }

  /* 平板 */
  @media (max-width: 900px) {
    .nav-links {
      gap: 18px;
    }

    .nav-links a {
      font-size: 15px;
    }
  }

  /* 手機 */
  @media (max-width: 700px) {
    .site-header {
      flex-direction: column;
      gap: 18px;
      padding: 20px;
    }

    .nav-links {
      width: 100%;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 12px 20px;
      margin-left: 0;
    }

    .nav-links a {
      font-size: 15px;
    }
  }
</style>